{
  "manifest_version": 3,
  "name": "Kids Cinema Captions",
  "version": "0.1.0",
  "description": "Adds optional overlay captions to Kids Drive Cinema without changing the website player.",
  "content_scripts": [
    {
      "matches": [
        "https://kids-drive-cinema.onrender.com/*",
        "https://drive-movies-cinema.onrender.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://kids-drive-cinema.onrender.com/*",
    "https://drive-movies-cinema.onrender.com/*"
  ]
}
