<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent frosted fill + rounded top + glass edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_panel" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- Top light hairline -->
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/glass_hairline_top"
                android:endColor="@color/scrim_transparent"
                android:angle="270" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
