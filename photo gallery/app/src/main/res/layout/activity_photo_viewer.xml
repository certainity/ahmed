<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Single-photo zoom view (used when no pager needed) -->
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Pager for gallery swipe -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:background="@drawable/scrim_top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_floating_icon"
            android:tint="@color/white" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textAppearance="@style/TextAppearance.PG.Body"
            android:textColor="@color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_star_outline"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_floating_icon"
            android:tint="@color/white"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_info"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_floating_icon"
            android:tint="@color/white"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:background="@drawable/scrim_bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btnShare">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_share"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_floating_icon"
                android:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textAppearance="@style/TextAppearance.PG.Caption"
                android:textColor="@color/white"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btnSlideshow">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:id="@+id/ivSlideshowIcon"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_floating_icon"
                android:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slideshow"
                android:textAppearance="@style/TextAppearance.PG.Caption"
                android:textColor="@color/white"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btnEdit">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:src="@drawable/ic_edit"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_gradient_accent"
                android:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textAppearance="@style/TextAppearance.PG.Caption"
                android:textColor="@color/accent"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/btnDelete">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:src="@drawable/ic_delete"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_floating_icon"
                android:tint="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textAppearance="@style/TextAppearance.PG.Caption"
                android:textColor="@color/white"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
