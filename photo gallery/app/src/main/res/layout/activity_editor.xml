<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Top toolbar ── -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/edit_photo"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:background="?attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/save"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="4dp"
            style="@style/Widget.Material3.Button"
            android:minWidth="72dp" />

    </LinearLayout>

    <!-- ── Photo display ── -->
    <FrameLayout
        android:id="@+id/photoFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <!-- Hold-to-compare hint -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Hold to compare original"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:background="#55000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <!-- Loading overlay -->
        <FrameLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#88000000"
            android:visibility="gone">
            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center" />
        </FrameLayout>

    </FrameLayout>

    <!-- ── Bottom panel ── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnFilter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_filter"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />

            <View android:layout_width="1dp" android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btnAdjust"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_adjust"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />

            <View android:layout_width="1dp" android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btnTransform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_transform"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- ── FILTER PANEL ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFilters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp"
            android:clipToPadding="false" />

        <!-- ── ADJUST PANEL ── -->
        <ScrollView
            android:id="@+id/panelAdjust"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Brightness -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/brightness" android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekBrightness"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:max="100"
                        android:progressTint="@color/accent" android:thumbTint="@color/accent" />
                    <TextView android:id="@+id/valBrightness"
                        android:layout_width="32dp" android:layout_height="wrap_content"
                        android:gravity="end" android:text="0"
                        android:textColor="@color/white" android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Contrast -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/contrast" android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekContrast"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:max="100"
                        android:progressTint="@color/accent" android:thumbTint="@color/accent" />
                    <TextView android:id="@+id/valContrast"
                        android:layout_width="32dp" android:layout_height="wrap_content"
                        android:gravity="end" android:text="0"
                        android:textColor="@color/white" android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Saturation -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/saturation" android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekSaturation"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:max="100"
                        android:progressTint="@color/accent" android:thumbTint="@color/accent" />
                    <TextView android:id="@+id/valSaturation"
                        android:layout_width="32dp" android:layout_height="wrap_content"
                        android:gravity="end" android:text="0"
                        android:textColor="@color/white" android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Warmth -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                        android:text="@string/warmth" android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <SeekBar android:id="@+id/seekWarmth"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:max="100"
                        android:progressTint="@color/accent" android:thumbTint="@color/accent" />
                    <TextView android:id="@+id/valWarmth"
                        android:layout_width="32dp" android:layout_height="wrap_content"
                        android:gravity="end" android:text="0"
                        android:textColor="@color/white" android:textSize="11sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ── TRANSFORM PANEL ── -->
        <LinearLayout
            android:id="@+id/panelTransform"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <!-- Rotate -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:id="@+id/btnRotate" android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_rotate" android:tint="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/rotate" android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Flip H -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:id="@+id/btnFlipH" android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_flip_h" android:tint="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/flip_h" android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Flip V -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:id="@+id/btnFlipV" android:padding="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_flip_v" android:tint="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/flip_v" android:textColor="@color/text_secondary"
                    android:textSize="11sp" android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- panelFilter is rvFilters (shown by default) -->

</androidx.constraintlayout.widget.ConstraintLayout>
