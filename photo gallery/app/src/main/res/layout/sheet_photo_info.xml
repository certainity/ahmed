<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_panel"
    android:padding="24dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#4DFFFFFF"
        android:backgroundTint="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Photo Info"
        android:textColor="@color/on_surface"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp" />

    <!-- Filename -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
            android:text="File" android:textColor="#8A93A6" android:textSize="13sp" />
        <TextView android:id="@+id/tvInfoName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/on_surface" android:textSize="13sp"
            android:maxLines="2" android:ellipsize="middle" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Size -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
            android:text="Size" android:textColor="#8A93A6" android:textSize="13sp" />
        <TextView android:id="@+id/tvInfoSize" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/on_surface" android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Date -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
            android:text="Date" android:textColor="#8A93A6" android:textSize="13sp" />
        <TextView android:id="@+id/tvInfoDate" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/on_surface" android:textSize="13sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Album -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="90dp" android:layout_height="wrap_content"
            android:text="Album" android:textColor="#8A93A6" android:textSize="13sp" />
        <TextView android:id="@+id/tvInfoAlbum" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/on_surface" android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom padding for nav bar -->
    <View android:layout_width="match_parent" android:layout_height="24dp" />

</LinearLayout>
