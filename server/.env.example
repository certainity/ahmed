# Your approved Google Drive folder.
# Source URL: https://drive.google.com/drive/folders/1AjHHDGV6G9FHbNL2GaVaIFsIwwANJf9l
GOOGLE_DRIVE_FOLDER_ID=1AjHHDGV6G9FHbNL2GaVaIFsIwwANJf9l

# Scan videos inside subfolders too. Keep this on for your current folder because it contains child folders.
INCLUDE_SUBFOLDERS=true
MAX_SCAN_DEPTH=8
MAX_FOLDERS=750

# Recommended auth option for a personal/private app:
# 1. Create a Google Cloud service account.
# 2. Download its JSON key as service-account.json into the server folder.
# 3. Share your movie folder with the service account email as Viewer.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Alternative to GOOGLE_APPLICATION_CREDENTIALS, useful on Render/Fly/Railway:
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

PORT=5174
CLIENT_ORIGIN=http://localhost:5173
CACHE_TTL_MS=300000

# Parent PIN belongs in client/.env. The real safety boundary is this backend.
