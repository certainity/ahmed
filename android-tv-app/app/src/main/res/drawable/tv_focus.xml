<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#35202C" /><stroke android:width="3dp" android:color="#FF6B7C" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#35202C" /><stroke android:width="1dp" android:color="#70404F" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#202632" /><stroke android:width="1dp" android:color="#303A4C" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
