<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#0F1117</item>
        <item name="android:colorAccent">#FF6B7C</item>
        <item name="android:statusBarColor">#0F1117</item>
        <item name="android:navigationBarColor">#0F1117</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="TvButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/tv_focus</item>
        <item name="android:textColor">#F1F5FC</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
